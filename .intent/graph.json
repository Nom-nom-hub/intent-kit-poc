  "nodes": {
    "DEC-001": {
      "created_at": "2026-08-16T20:57:07+00:00",
      "description": "Version-controlled policies make the public maintenance contract reviewable and auditable.",
      "id": "DEC-001",
      "properties": {
        "alternatives": [
          "Maintain governance only in external documentation"
        ]
      },
      "status": "proposed",
      "title": "Keep repository governance version-controlled",
      "type": "decision",
      "updated_at": "2026-08-16T20:57:07+00:00"
    },
    "DEC-002": {
      "created_at": "2026-08-16T20:57:07+00:00",
      "description": "Read-only import plus artifact hashes preserves trust in the migration record.",
      "id": "DEC-002",
      "properties": {
        "alternatives": [
          "Rewrite source Markdown during import"
        ]
      },
      "status": "proposed",
      "title": "Import source artifacts read-only with provenance",
      "type": "decision",
      "updated_at": "2026-08-16T20:57:07+00:00"
    },
    "DEC-003": {
      "created_at": "2026-08-16T20:57:07+00:00",
      "description": "A durable evidence record keeps release verification reviewable alongside requirements.",
      "id": "DEC-003",
      "properties": {
        "alternatives": [
          "Rely only on terminal history"
        ]
      },
      "status": "proposed",
      "title": "Record release evidence in the intent graph",
      "type": "decision",
      "updated_at": "2026-08-16T20:57:07+00:00"
    },
    "DEC-004": {
      "created_at": "2026-08-16T21:08:59+00:00",
      "description": "Traversing typed edges in both directions exposes outcome context, implementation tasks, proof obligations, and evidence without inferring semantic changes.",
      "id": "DEC-004",
      "properties": {
        "alternatives": [
          "Show only downstream implementation tasks"
        ]
      },
      "status": "proposed",
      "title": "Use deterministic bidirectional graph traversal",
      "type": "decision",
      "updated_at": "2026-08-16T21:08:59+00:00"
    },
    "DEC-005": {
      "created_at": "2026-08-16T21:22:44+00:00",
      "description": "A public, repeatable quality matrix makes validation visible to contributors and catches regressions before merge.",
      "id": "DEC-005",
      "properties": {
        "alternatives": [
          "Rely only on local validation before push"
        ]
      },
      "status": "proposed",
      "title": "Run a minimal GitHub Actions quality matrix",
      "type": "decision",
      "updated_at": "2026-08-16T21:22:44+00:00"
    },
    "DEC-006": {
      "created_at": "2026-08-16T21:32:08+00:00",
      "description": "JSON-only packs provide consistent defaults without executing code or weakening the trusted checker boundary.",
      "id": "DEC-006",
      "properties": {
        "alternatives": [
          "Embed policy behavior in hard-coded workflow prompts"
        ]
      },
      "status": "proposed",
      "title": "Keep policies declarative and local",
      "type": "decision",
      "updated_at": "2026-08-16T21:32:08+00:00"
    },
    "DEC-007": {
      "created_at": "2026-08-16T21:46:54+00:00",
      "description": "Explicit project authorization and digest pinning make external execution reviewable while preserving graph ownership in the core.",
      "id": "DEC-007",
      "properties": {
        "alternatives": [
          "Discover installed Python checker packages automatically"
        ]
      },
      "status": "proposed",
      "title": "Use manifest-pinned JSON subprocesses",
      "type": "decision",
      "updated_at": "2026-08-16T21:46:54+00:00"
    },
